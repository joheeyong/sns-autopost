# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env

# --- 이미지 공개 URL 용 (인스타·스레드 이미지 업로드에 필요) ---
# https://api.imgbb.com 에서 무료 키 발급
IMGBB_API_KEY=

# --- Instagram (Instagram 로그인 방식 API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Threads ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- X (developer.x.com > 앱 > Keys and tokens, 권한은 Read and Write) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
